# Required: generate unique values for your deployment.
MYSQL_DATABASE=sentinel_atlas
MYSQL_USER=sentinel
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-a-long-random-session-secret

# Optional: needed for Manus OAuth and built-in AI features.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Public host port.
APP_PORT=3000
