{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-atlas-node-reference",
  "compatibility_date": "2026-09-18",
  "main": "./dist/index.js",
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
